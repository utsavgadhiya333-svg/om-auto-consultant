{
  "version": 2,
  "builds": [
    {
      "src": "admin-om-auto/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/admin-om-auto/(.*)",
      "dest": "/admin-om-auto/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}